{
  "name": "@two-cents/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.668.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@prisma/client": "^5.20.0",
    "@two-cents/shared": "workspace:*",
    "bullmq": "^5.18.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "iron-session": "^8.0.4",
    "jose": "^6.2.3",
    "openid-client": "^5.7.0",
    "pino": "^9.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/nock": "^11.1.0",
    "@types/node": "^22.7.0",
    "@types/web-push": "^3.6.4",
    "nock": "^14.0.15",
    "prisma": "^5.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
